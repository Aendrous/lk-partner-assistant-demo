# Скопируйте в .env и подставьте ключ из GigaChat Studio.
# Документация: https://developers.sber.ru/docs/ru/gigachat/quickstart/ind-using-api
# Studio → Настройки API → «Получить ключ» → поле Authorization Key (уже Base64).
#
# ПИЛОТ: допустим личный ключ PERS (Freemium). Это не корпоративный прод IEK.
# На хостинге тот же ключ — только в Secrets, не в git.

GIGACHAT_AUTHORIZATION_KEY=

# ИЛИ вместо Authorization Key — пара Client ID + Client Secret:
GIGACHAT_CLIENT_ID=
GIGACHAT_CLIENT_SECRET=

# PERS — физлицо (Freemium). Для юрлица IEK нужен отдельный ключ и scope CORP (согласовать с ИБ).
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# Модель как в ClubOfSisters (Studio: Ultra 3.5 New → GigaChat-3-Ultra)
GIGACHAT_MODEL=GigaChat-3-Ultra
