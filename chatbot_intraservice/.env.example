# Секреты чатбота IntraService (1 линия HelpDesk). Не коммитить.
# Скопируйте в .env и подставьте значения (или из корня: python scripts/copy_intraservice_env.py).

# --- HelpDesk IntraService ---
INTRASERVICE_BASE_URL=https://helpdesk.iek.local
INTRASERVICE_SHORT_TASK_URL_TEMPLATE=https://hd.iek.group/Task/View/{id}
INTRASERVICE_USER=
INTRASERVICE_PASSWORD=
# INTRASERVICE_USER_AS_IS=1

# --- Корпоративный LLM (шлюз) ---
IEK_LLM_BASE_URL=https://llm.iek.local/v1
IEK_LLM_TOKEN=
# Open WebUI (chatgpt.iek.local): создание карточек *-web-helper, Knowledge
IEK_LLM_API_KEY=
IEK_LLM_MODEL=iek/gpt-oss-120b
IEK_LLM_PARTNER_MODEL=iek/qwen3.5-122b-vl-int4
# Ассистент 1 линии (разбор заявок HelpDesk):
IEK_LLM_SUPPORT_MODEL=iek/gpt-oss-120b
IEK_LLM_SUPPORT_FALLBACK_MODEL=iek/gpt-oss-120b
# Самообучение AI-KB (learn_compare, kb_gap_llm):
# IEK_LLM_LEARN_MODEL=iek/gpt-oss-120b
IEK_LLM_CRM_MODEL=iek/gpt-oss-120b
# Ассистент разбора заявок БП (профиль bp_tickets):
# IEK_LLM_BP_MODEL=iek/gpt-oss-120b
# IEK_LLM_BP_FALLBACK_MODEL=iek/gpt-oss-120b
# Устарело (снято с LiteLLM 2026-09): iek/confluence-agent, iek/confluence-agent-crm
# Поиск Confluence — REST prefetch (confluence_tools.py), не RAG-агент на прокси.
# Подсказка UI (не id API): support-dep-lk-web-helper / support-dep-l1-ticket-helper
# IEK_LLM_SUPPORT_OWUI_ID=support-dep-l1-ticket-helper

# --- n8n (оркестрация вместо Task Scheduler) ---
# Ключ REST n8n — в корневом .env (N8N_API_KEY). Пакет подхватывает через env_bootstrap.
# URL HTTP API бота для исходящих вызовов из n8n (ноды POST /run/watch-*):
# Co-located (бот на том же хосте, что n8n worker): http://127.0.0.1:8765
# Удалённый хост бота: http://<IP_хоста_бота>:8765
# N8N_BOT_CALLBACK_URL=http://127.0.0.1:8765
# N8N_BOT_API_KEY=случайная_строка
# N8N_BOT_HTTP_HOST=0.0.0.0
# N8N_BOT_HTTP_PORT=8765

# --- adm.bp.iek.ru (проверка регистрации клиента) ---
# Из браузера (Application → Cookies adm.bp.iek.ru): kc-access + kc-state (+ kc-refresh если есть).
# BP_ADM_COOKIE=kc-access=eyJ...; kc-state=...; kc-refresh=...
# kc-access обновляется автоматически (POST /api/auth/v1/refresh) → .bp_adm_session.json и .env
# BP_ADM_REFRESH_SEC=120

# --- lk.iek.ru Bitrix admin (поиск пользователя по email) ---
# Вариант A — cookie из браузера (Application → Cookies lk.iek.ru):
# LK_ADMIN_COOKIE=PHPSESSID=...; BITRIX_SM_UIDH=...; BITRIX_SM_UIDL=...
# Вариант B — логин поддержки (если cookie нет):
# LK_BASE_URL=https://lk.iek.ru
# LK_USER=
# LK_PASSWORD=
# Без доступа в разборе будет ссылка user_admin.php?find=<email>&find_type=email для ручной проверки.

# --- bp.iek.ru / adm (опционально; основной способ — BP_ADM_COOKIE выше) ---
# BP_BASE_URL=https://bp.iek.ru
# BP_USER=
# BP_PASSWORD=

# --- Confluence WEBKB ---
CONFLUENCE_BASE_URL=https://confluence.dev.iek.ru
CONFLUENCE_PAT=

# --- Автообучение AI-KB (чатбот IntraService) ---
# INTRASERVICE_AUTO_LEARN_KB=0
# INTRASERVICE_AUTO_LEARN_ON_CLOSE=1
# INTRASERVICE_AUTO_LEARN_ON_ANALYZE=0
# INTRASERVICE_AUTO_POST_COMMENT=0
# INTRASERVICE_SKIP_IF_KB_FOUND=1
# INTRASERVICE_SKIP_IF_DRAFT_EXISTS=1
# --- 1С (проверка заказа, галка «Резервировать товары в пути») ---
# COM (кластер): 1C_CONN=Srvr="jack";Ref="plazma"
# либо то же значение в 1C_BASE_URL (без http) — детектируется как COM
# HTTP OData: 1C_BASE_URL=https://<хост-1с>/...
# 1C_USER=
# 1C_USER_PASSWORD=
# 1C_ORDER_DOC=ЗаказПокупателя
# 1C_RESERVE_IN_TRANSIT_FIELD=РезервироватьТоварыВПути
# Нужен V83.COMConnector той же разрядности, что и Python (часто 32-bit).


# --- Запасной GigaChat ---
GIGACHAT_AUTHORIZATION_KEY=
GIGACHAT_CLIENT_ID=
GIGACHAT_CLIENT_SECRET=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-3-Ultra
