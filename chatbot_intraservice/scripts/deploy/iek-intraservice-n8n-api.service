# systemd unit: HTTP API для n8n (co-located на том же сервере, что n8n.iek.local)
#
# Установка (Linux, от root):
#   sudo cp scripts/deploy/iek-intraservice-n8n-api.service /etc/systemd/system/
#   sudo sed -i 's|/opt/iek-chatbot-intraservice|/actual/path|g' /etc/systemd/system/iek-intraservice-n8n-api.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now iek-intraservice-n8n-api
#   curl -s http://127.0.0.1:8765/health
#
# Workflow n8n: http://127.0.0.1:8765/run/watch-new (если worker на том же хосте)
# Если n8n в Docker — см. docs/интеграции/n8n.md (host.docker.internal)

[Unit]
Description=IEK IntraService chatbot HTTP API for n8n
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=iekbot
Group=iekbot
WorkingDirectory=/opt/iek-chatbot-intraservice
EnvironmentFile=/opt/iek-chatbot-intraservice/.env
ExecStart=/opt/iek-chatbot-intraservice/.venv/bin/python scripts/n8n_http_server.py --host 0.0.0.0 --port 8765
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
